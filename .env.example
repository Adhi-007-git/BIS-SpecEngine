# ==============================================================================
# SIH26108 - Indian Standards AI Recommendation Engine Environment Configuration
# ==============================================================================

# Application Environment (development / production)
ENVIRONMENT=development
DEV_MODE=true

# FastAPI Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Relational Database (PostgreSQL / SQLite Dev Fallback)
# If PostgreSQL is running: postgresql://sih_user:sih_password@localhost:5432/sih_standards
# When DEV_MODE=true, the app automatically falls back to sqlite:///./sih_dev.db if PostgreSQL is unavailable.
DATABASE_URL=postgresql://example_user:CHANGE_ME@localhost:5432/example_db

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_STANDARDS=indian_standards
QDRANT_COLLECTION_CHUNKS=tender_chunks

# Knowledge Graph (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# Embedding Model Configuration (Phase 6B — BGE-M3 Real Embeddings)
# EMBEDDING_PROVIDER: bge-m3 | fallback | auto
#   bge-m3   = Real BGE-M3 via sentence-transformers (requires installation)
#   fallback = Deterministic hash-vector fallback (zero-dependency dev mode)
#   auto     = Use bge-m3 if available, otherwise fall back automatically
# EMBEDDING_MODEL: HuggingFace model identifier
# HF_HOME: Override Hugging Face model cache directory
#   IMPORTANT: Set to a drive with sufficient space (BAAI/bge-m3 is ~2.3 GB)
#   On machines where C: is small, set to a larger drive e.g. E:\huggingface_cache
EMBEDDING_PROVIDER=bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
HF_HOME=E:\huggingface_cache

# LLM Provider Configuration (Phase 6A — Query Understanding)
# LLM_PROVIDER: gemini | openai | mock  (leave blank to auto-detect from key prefix)
# LLM_API_KEY:  Google AI Studio key (AIza...) or OpenAI key (sk-...). Leave blank for mock/offline mode.
# LLM_MODEL:    gemini-1.5-flash (Gemini) or gpt-4o-mini (OpenAI). Defaults apply when blank.
# LLM_TIMEOUT:  HTTP request timeout in seconds. Default: 5.0
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT=5.0
